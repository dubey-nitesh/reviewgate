# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres (docker-compose builds DATABASE_URL from these for the app service)
POSTGRES_DB=reviewgate
POSTGRES_USER=reviewgate
POSTGRES_PASSWORD=changeme

# GitHub App credentials — from your app's settings page
# (https://github.com/settings/apps/<your-app>)
APP_ID=123456
WEBHOOK_SECRET=changeme

# Place your GitHub App's downloaded private key at ./private-key.pem
# (gitignored, mounted read-only into the app container) — not set here.

# Optional: only needed for local development via a webhook proxy (smee.io)
WEBHOOK_PROXY_URL=

# Optional
PORT=3000
LOG_LEVEL=info

# Optional: only needed if you run the Grafana service (docker-compose.yml)
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_PORT=3001
